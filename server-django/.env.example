# Same variables as backend/.env - that file works here unchanged.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS - "*" or one or more comma-separated origins. The first one is also
# used as the frontend URL for Microsoft login redirects and bot links.
CORS_ORIGIN=*

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/org_tasks

# Authentication - must match the Node backend's secret for tokens to work on both
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional Django-only settings
# SECRET_KEY=          (defaults to JWT_SECRET)
# ALLOWED_HOSTS=*
# UPLOADS_DIR=         (defaults to ./uploads; point at backend/uploads to share files)

# WhatsApp bot (Meta Cloud API) - optional; set all three to enable /whatsapp/webhook.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Microsoft/Outlook login - optional; set all four to enable /auth/microsoft/*.
# MICROSOFT_REDIRECT_URI must end in /api/auth/microsoft/callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_VALUE=
MICROSOFT_REDIRECT_URI=

# Task reminders - SMS (Advanta) - optional.
ADVANTA_SMS_URL=
ADVANTA_API_KEY=
ADVANTA_PARTNER_ID=
ADVANTA_SHORTCODE=

# Task reminders - Email (SMTP) - optional.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
