# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS - comma-separated list of allowed origins (use * for open access in dev)
CORS_ORIGIN=*

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# WhatsApp bot (Meta Cloud API) - optional. Leave unset to keep the bot
# disabled; set all three to enable GET/POST /whatsapp/webhook.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Task reminders - SMS (Advanta) - optional. Leave unset to keep the SMS
# reminder channel disabled.
ADVANTA_SMS_URL=
ADVANTA_API_KEY=
ADVANTA_PARTNER_ID=
ADVANTA_SHORTCODE=

# Task reminders - Email (SMTP) - optional. Leave unset to keep the Email
# reminder channel disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
