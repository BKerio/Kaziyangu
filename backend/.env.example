# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS - comma-separated list of allowed origins (use * for open access in dev)
CORS_ORIGIN=*

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# WhatsApp bot (Meta Cloud API) - optional. Leave unset to keep the bot
# disabled; set all three to enable GET/POST /whatsapp/webhook.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Microsoft/Outlook login (OAuth account linking + calendar read) - optional.
# Leave unset to keep it disabled; set all four to enable GET /auth/microsoft/*.
# MICROSOFT_CLIENT_VALUE is the Secret "Value" column from Azure (not the
# Secret ID). MICROSOFT_REDIRECT_URI must exactly match a redirect URI
# registered on the Azure App Registration, and must be reachable at the
# path /api/auth/microsoft/callback on this server's public URL - add one
# entry per environment (e.g. both the local and the live callback URL) to
# the same Azure app's Redirect URIs list.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_VALUE=
MICROSOFT_REDIRECT_URI=

# Task reminders - SMS (Advanta) - optional. Leave unset to keep the SMS
# reminder channel disabled.
ADVANTA_SMS_URL=
ADVANTA_API_KEY=
ADVANTA_PARTNER_ID=
ADVANTA_SHORTCODE=

# Task reminders - Email (SMTP) - optional. Leave unset to keep the Email
# reminder channel disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
